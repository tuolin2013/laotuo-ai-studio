# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 忽略，切勿提交。

# ===== RightAPI 统一网关（只需 2 把 Key）=====
# 官方文档 https://docs.rightapi.ai/docs/rc_draw/ 的基础地址（填 rightapi.ai 会自动补 www）
RIGHTAPI_BASE_URL=https://www.rightapi.ai

# Key 1：Claude LLM（Claude AwsQ 或 Claude 官渠 Key）
#   负责电商策划 / 视频编剧 / 生图提示词 / H3 提示词 Skill
RIGHTAPI_LLM_KEY=
RIGHTAPI_LLM_MODEL=claude-opus-5-5
# auto：先试 /v1/messages（Anthropic 原生），404/405 自动回退 /v1/chat/completions（OpenAI 兼容）
RIGHTAPI_LLM_API_FORMAT=auto
RIGHTAPI_LLM_TIMEOUT_SECONDS=180

# Key 2：画图 Key（生产请用「image 高质量」渠道：全模型 4K、异步、不限并发）
#   GPT Image 与 Nano Banana 共用这一把 Key，协议由模型决定（见 app/providers/image_models.py）：
#   gpt-image-2.5-flare / gpt-image-2.5-sunburst / gpt-image-2  -> OpenAI 生成
#       无参考图 POST /v1/images/generations；有参考图 POST /v1/images/edits
#   gemini-3-pro-image-preview / gemini-nano-banana-2.1           -> Gemini 生成
#       POST /v1beta/models/{model}:generateContent（文生图与参考图编辑同一接口）
#   全部 "async": true 提交，轮询 GET /v1/tasks/{task_id}，结果为图片 URL
RIGHTAPI_IMAGE_KEY=

# Key 3（选填）：「image 普通」渠道的画图 Key。RightAPI 的 Key 绑定渠道，只能调用该渠道下的模型，
#   所以普通渠道要单独创建一把 Key。留空时普通渠道的模型走演示模式。
#   gpt-image-2 / gpt-image-2-vip / gpt-image-2.5        -> OpenAI 生成（接口同上）
#   nano-banana-pro / nano-banana-2 / nano-banana-2-lite   -> Gemini 生成（接口同上）
RIGHTAPI_IMAGE_STD_KEY=
# 普通渠道的 Base URL（后台「模型列表」里该渠道的 BaseUrl）；留空 = 与 RIGHTAPI_BASE_URL 相同
RIGHTAPI_IMAGE_STD_BASE_URL=

# 界面可选模型（逗号分隔，必须是目录中登记过的 ID；留空 = 两个渠道全部 11 个模型，高质量渠道在前）
#   两个渠道都有 gpt-image-2：高质量渠道写 gpt-image-2，普通渠道写 gpt-image-2@image
RIGHTAPI_IMAGE_MODELS=
# 默认分辨率 1K / 2K / 4K（GPT Image 自动换算为合法像素尺寸；Gemini 作为 imageSize）
RIGHTAPI_IMAGE_RESOLUTION=2K
# GPT Image 默认质量：auto / low / medium / high / xhigh / max（xhigh、max 仅 2.5 模型）
RIGHTAPI_IMAGE_QUALITY=high
# 单个异步任务最长等待秒数、轮询间隔秒数（文档建议 3~5 秒）
RIGHTAPI_IMAGE_TIMEOUT_SECONDS=600
RIGHTAPI_IMAGE_POLL_SECONDS=4
# 上游繁忙（temporarily busy / 429 / 503）时自动重新提交的次数，等待约 15、30、45 秒；0 = 不重试
RIGHTAPI_IMAGE_BUSY_RETRIES=3
# 同时进行的画图任务数（高质量渠道不限并发，此值只为保护本机网络）
RIGHTAPI_IMAGE_CONCURRENCY=8

# ===== 视频生成 =====
# 视频统一由 Modal MiniMax H3 生成（本机未登录 Modal 或演示模式时自动使用本地演示后端）
DEFAULT_VIDEO_PROVIDER=modal_minimax_h3
VIDEO_TIMEOUT_SECONDS=600

# MiniMax H3：通过 Modal SDK 按「应用名 + 类名」调用已部署的服务（modal/h3_diffusers_service.py），
# 使用本机 Modal 登录（~/.modal.toml，或 MODAL_TOKEN_ID / MODAL_TOKEN_SECRET），不需要 URL / Key。
# 统一走 ref2va：<Picture 1> = 锁定首帧，分镜绑定了商品参考图时依次作为 <Picture 2>…一起送入。
# 冷启动 + 推理单镜通常 5~8 分钟，按 GPU 秒数计费。
MODAL_H3_APP=minimax-h3-diffusers-service
MODAL_H3_CLASS=H3BatchRunner
MODAL_H3_STEPS=30
MODAL_H3_TIMEOUT_SECONDS=2400

# ===== 配音：VoxCPM2（【配音】选项卡）=====
# 同样通过 Modal SDK 调用已部署的服务（modal/voxcpm_service.py），使用本机 Modal 登录，不需要 URL / Key。
# 未登录 Modal 或演示模式时使用本地演示后端（提示音合成，不是真实人声）。
# 首次调用冷启动约 2 分钟（A10G），之后每段几秒；空闲 2 分钟后自动释放 GPU。
MODAL_VOXCPM_APP=voxcpm2-tts-service
MODAL_VOXCPM_CLASS=VoxCPM2Service
# 单段合成的最长等待秒数（含冷启动）
MODAL_VOXCPM_TIMEOUT_SECONDS=600

# fal.ai（预留，尚未实现）
FAL_KEY=
FAL_VIDEO_MODEL=

# ===== 剪辑大师：导出剪映草稿 =====
# 剪映专业版的草稿文件夹（剪映 → 设置 → 全局设置 → 草稿位置）。填写后导出的草稿直接出现在剪映「本地草稿」里。
# 留空时自动查找 %LOCALAPPDATA%\JianyingPro\User Data\Projects\com.lveditor.draft（或 CapCut 同名目录），
# 都找不到时只打包 zip 供下载
JIANYING_DRAFT_DIR=

# ===== 演示模式 =====
# true：即使填写了 Key 也不调用真实接口，全部使用本地逼真演示（不消耗额度）
# 任一通道未填写 Key / 地址时，该通道会自动使用演示模式
DEMO_MODE=false
# 公共免 Key 在线演示（部署到 Hugging Face Space 等公开网址时用，见 deploy/README_FREE_DEMO.md）：
# 1 = 强制演示模式、不读取任何 Key、不显示 API 配置；每位访客自动得到一份示例项目，动效单条最长 30 秒，
#     1 小时没有操作的项目自动清理；数据放在 WORKSPACE_DIR/public_demo/。本机日常使用请保持留空
LAOTUO_PUBLIC_DEMO=

# ===== 本地运行 =====
WORKSPACE_DIR=workspace
# 默认只监听本机；改成 0.0.0.0 会暴露到局域网，且界面没有登录鉴权
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
