# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 忽略，切勿提交。

# ===== RightAPI 统一网关 =====
RIGHTAPI_BASE_URL=https://www.rightapi.ai

# Key 1：Claude LLM（策划 / 视频编剧 / 生图提示词 / H3 提示词 Skill）
RIGHTAPI_LLM_KEY=
RIGHTAPI_LLM_MODEL=claude-opus-5-5
RIGHTAPI_LLM_TIMEOUT_SECONDS=180

# Key 2：OpenAI 图像兼容接口
#   参考图 == 0 -> POST /v1/images/generations
#   参考图 >= 1 -> POST /v1/images/edits
RIGHTAPI_OPENAI_IMAGE_KEY=
RIGHTAPI_OPENAI_IMAGE_MODEL=gpt-image-2
RIGHTAPI_OPENAI_IMAGE_MODELS=gpt-image-2,gpt-image-2.5-flare,gpt-image-2.5-sunburst

# Key 3：Gemini 图像兼容接口
#   统一 POST /v1beta/models/{model}:generateContent（不使用 :streamGenerateContent）
RIGHTAPI_GEMINI_IMAGE_KEY=
RIGHTAPI_GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
RIGHTAPI_GEMINI_IMAGE_MODELS=gemini-3-pro-image-preview,gemini-nano-banana-2.1
# 是否以 "async": true 提交并轮询 task_id
RIGHTAPI_GEMINI_ASYNC=false
# 任务轮询地址模板（{task_id} 会被替换）。请以 RightAPI 官方文档为准后填写
RIGHTAPI_GEMINI_TASK_URL_TEMPLATE=
RIGHTAPI_IMAGE_TIMEOUT_SECONDS=300

# ===== 视频生成 =====
# 可选：modal_minimax_h3 | manual_comfyui | fal_ai
DEFAULT_VIDEO_PROVIDER=manual_comfyui
VIDEO_TIMEOUT_SECONDS=600

# Modal 上部署的 MiniMax H3 推理接口（Serverless，首次调用有冷启动）
MODAL_MINIMAX_H3_URL=
MODAL_MINIMAX_H3_WARMUP_URL=
MODAL_MINIMAX_H3_TOKEN=

# Modal 上部署的 ComfyUI MiniMax All-in-One 页面地址（人工复制提示词使用）
COMFYUI_URL=

# fal.ai（预留，尚未实现）
FAL_KEY=
FAL_VIDEO_MODEL=

# ===== 本地运行 =====
WORKSPACE_DIR=workspace
# 默认只监听本机；改成 0.0.0.0 会暴露到局域网，且界面没有登录鉴权
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
