# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 忽略，切勿提交。

# ===== RightAPI 统一网关（只需 2 把 Key）=====
# 令牌管理页显示的标准 Base URL；末尾的 / 或 /v1 会被自动去掉
RIGHTAPI_BASE_URL=https://rightapi.ai

# Key 1：Claude LLM（Claude AwsQ 或 Claude 官渠 Key）
#   负责电商策划 / 视频编剧 / 生图提示词 / H3 提示词 Skill
RIGHTAPI_LLM_KEY=
RIGHTAPI_LLM_MODEL=claude-opus-5-5
# auto：先试 /v1/messages（Anthropic 原生），404/405 自动回退 /v1/chat/completions（OpenAI 兼容）
# 也可固定为 anthropic 或 openai
RIGHTAPI_LLM_API_FORMAT=auto
RIGHTAPI_LLM_TIMEOUT_SECONDS=180

# Key 2：Image 渠道通用画图 Key（如后台名为 draw 的那把），GPT-Image 与 Nano-Banana 共用
#   GPT-Image：参考图 == 0 -> POST /v1/images/generations；>= 1 -> POST /v1/images/edits
#   Nano-Banana：POST /v1beta/models/{model}:generateContent（不使用 :streamGenerateContent），
#                原生端点 404/405 时自动回退到上面的 OpenAI Images 兼容端点
#   （旧版的 RIGHTAPI_OPENAI_IMAGE_KEY / RIGHTAPI_GEMINI_IMAGE_KEY 仍可识别，但请改用本项）
RIGHTAPI_IMAGE_KEY=
# 界面下拉框中的模型列表
RIGHTAPI_OPENAI_IMAGE_MODELS=gpt-image-2.5,gpt-image-2
RIGHTAPI_GEMINI_IMAGE_MODELS=nano-banana-pro,nano-banana-2,nano-banana-2-lite
# 画图分辨率：1K / 2K / 4K
RIGHTAPI_IMAGE_RESOLUTION=2K
# Nano-Banana 原生端点不可用时是否回退 OpenAI Images 兼容端点
RIGHTAPI_GEMINI_OPENAI_FALLBACK=true
# Nano-Banana 是否以 "async": true 提交并轮询 task_id
RIGHTAPI_GEMINI_ASYNC=false
# 任务轮询地址模板（{task_id} 会被替换）。请以 RightAPI 官方文档为准后填写
RIGHTAPI_GEMINI_TASK_URL_TEMPLATE=
RIGHTAPI_IMAGE_TIMEOUT_SECONDS=300

# ===== 视频生成 =====
# 可选：modal_minimax_h3 | manual_comfyui | fal_ai（未配置地址时自动使用本地演示后端）
DEFAULT_VIDEO_PROVIDER=modal_minimax_h3
VIDEO_TIMEOUT_SECONDS=600

# Modal 上部署的 MiniMax H3 推理接口（Serverless，首次调用有冷启动）
MODAL_H3_ENDPOINT_URL=
MODAL_H3_WARMUP_URL=
MODAL_H3_TOKEN=

# Modal 上部署的 ComfyUI MiniMax All-in-One 页面地址（人工复制提示词使用）
COMFYUI_URL=

# fal.ai（预留，尚未实现）
FAL_KEY=
FAL_VIDEO_MODEL=

# ===== 演示模式 =====
# true：即使填写了 Key 也不调用真实接口，全部使用本地逼真演示（不消耗额度）
# 任一通道未填写 Key / 地址时，该通道会自动使用演示模式
DEMO_MODE=false

# ===== 本地运行 =====
WORKSPACE_DIR=workspace
# 默认只监听本机；改成 0.0.0.0 会暴露到局域网，且界面没有登录鉴权
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
